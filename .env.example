# Copie para `.env` na raiz do projeto e preencha com credenciais de teste.
# (Opcional: `tests/.env` sobrescreve valores da raiz.)

# Ambiente: `local` (localhost:4200) ou `app` (produção).
# Também pode usar os scripts: npm run test:local | npm run test:app
E2E_TARGET=app

# Opcional — sobrescreve o preset do E2E_TARGET:
# E2E_BASE_URL=http://localhost:4200
# E2E_API_URL=http://localhost:3000/api
# E2E_BASE_URL=https://app.controledental.com.br
# E2E_API_URL=https://api.controledental.com.br/api

E2E_USER_EMAIL=seu-email@exemplo.com
E2E_USER_PASSWORD="sua-senha-com-caracteres-especiais"

# Billing/checkout: mantenha false (default) para mockar APIs de cobrança nos testes.
# Cobre: assinatura SaaS (/api/billing/**), link de cobrança, boleto, baixa (Pagar) e domínios Asaas/Stripe.
# Defina true apenas se souber que está em ambiente sandbox e quer testar integração real.
E2E_ALLOW_REAL_BILLING=false

# Dashboard / hospedagem Node (Hostinger define PORT automaticamente)
# E2E_DASHBOARD_HOST=0.0.0.0
# E2E_DASHBOARD_PORT=4173
# E2E_DASHBOARD_SESSION_SECRET=uma-chave-secreta-longa-e-aleatoria
# PLATFORM_API_URL=https://api.controledental.com.br/api/platform

# GitHub Actions (recomendado na Hostinger — testes rodam no GitHub, report volta ao dashboard)
# GITHUB_TOKEN=ghp_... (PAT com permissão repo + actions:read/write)
# GITHUB_REPO=kaiquesp/controle-dental-playwright
# GITHUB_WORKFLOW_FILE=playwright.yml
# GITHUB_WORKFLOW_REF=main
# E2E_RUNNER=github
#
# Secrets E2E_USER_EMAIL e E2E_USER_PASSWORD vão no GitHub (Settings → Secrets → Actions),
# não na Hostinger.

# Execução local de browser (alternativa ao GitHub Actions)
# PLAYWRIGHT_WS_ENDPOINT=ws://seu-vps:3333/
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# E2E_RUNNER=local
